# ==== Telegram Link Bypass & Shortener Bot configuration ====
# Copy this file to .env and fill in your values.

# REQUIRED: token from @BotFather
BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Comma-separated numeric Telegram user IDs allowed to use admin
# commands (/stats, /broadcast, /purgecache, /health, /update).
# Get your ID via @userinfobot. Admins must /start the bot once so it
# can send them health/update notifications.
ADMIN_IDS=YOUR_NUMERIC_TELEGRAM_ID,FRIENDS_NUMERIC_TELEGRAM_ID

# SQLite database location (relative to the project directory)
DB_PATH=data/bot.db

# --- v4: MongoDB storage backend (alternative to SQLite) ----------------
# Set MONGODB_URI and the bot switches automatically (DB_BACKEND then
# defaults to mongodb). Explicit: DB_BACKEND=sqlite|mongodb
# DB_BACKEND=sqlite
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true
# MONGODB_DB=telegram_bypass_bot

# Hours a bypassed/shortened link stays in cache (default 24)
CACHE_TTL_HOURS=24

# Anti-spam: seconds a normal user must wait between links (default 5)
COOLDOWN_SECONDS=5

# Only auto-shorten plain URLs at least this long (default 60 chars)
MIN_SHORTEN_LENGTH=60

# Hard limit for a single bypass attempt in seconds (default 60)
BYPASS_TIMEOUT_SECONDS=60

# Max links processed from one message (default 3)
MAX_LINKS_PER_MESSAGE=3

# Default UI language for new users whose Telegram language isn't
# supported yet (en / hi)
DEFAULT_LANG=en

# --- v2: maintenance ----------------------------------------------------

# Auto-apply dependency upgrades when the daily check finds newer
# versions, then restart (systemd/Docker restarts automatically).
# false = only notify admins. /update apply always works regardless.
AUTO_UPDATE=false

# How often (hours) to check PyPI for dependency updates (default 24)
UPDATE_CHECK_INTERVAL_HOURS=24

# How often (minutes) to run the full self-diagnostics: database,
# internet, is.gd, tinyurl, bypass engine (default 30, minimum 5)
HEALTHCHECK_INTERVAL_MINUTES=30

# Heartbeat file location (Docker HEALTHCHECK watches its mtime)
HEARTBEAT_PATH=data/heartbeat

# --- v3: per-user daily quotas ------------------------------------------
# Successful bypasses/shortens per user per UTC day. 0 = unlimited.
# Cached results are always free; failures don't count; admins and
# premium users are exempt. /quota shows users their usage,
# /setquota and /setpremium manage individuals (or use the web dashboard).
DAILY_BYPASS_QUOTA=100
DAILY_SHORTEN_QUOTA=200

# Premium users (set via /setpremium or the dashboard) skip quotas
PREMIUM_EXEMPT_QUOTA=true

# --- v3: web admin dashboard ---------------------------------------------
# The dashboard is ENABLED automatically when WEB_ADMIN_PASSWORD is set.
# Login at http://<host>:<port>/ — see DEPLOYMENT.md for remote access
# (SSH tunnel / reverse proxy) and PaaS notes ($PORT is honoured).
WEB_ADMIN_PASSWORD=
# WEB_DASHBOARD_ENABLED=true     # explicit override
# WEB_HOST=127.0.0.1             # 0.0.0.0 only behind a reverse proxy / VPN
# WEB_PORT=8080
# WEB_SECRET_KEY=                # default: auto-generated & persisted

# --- v4: extra resolvers + Cloudflare shield ---------------------------
# Best-effort fallback through adbypass.org for Linkvertise-hard /
# AdMaven / Lootlink links (Linkvertise ?r= fast path is always on)
API_RESOLVERS=true

# Circuit breaker: consecutive Cloudflare-blocked resolutions before a
# domain cools down (bypasses then fail fast instead of looping)
CF_BREAKER_THRESHOLD=3

# How long a Cloudflare-blocked domain stays in cooldown (minutes)
CF_BREAKER_COOLDOWN_MIN=30

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
